{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "carekey",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "carekey.app:create_app",
        "--factory",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "carekey-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_PATH=test-run.db",
        "uv",
        "run",
        "uvicorn",
        "carekey.app:create_app",
        "--factory",
        "--port",
        "8002"
      ],
      "port": 8002
    },
    {
      "name": "video-sim",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUIET_MORNING_BY=23:59",
        "RING_MODE=fake",
        "RING_POLL_SECONDS=0",
        "DB_PATH=submission/video/sim.db",
        "uv",
        "run",
        "uvicorn",
        "carekey.app:create_app",
        "--factory",
        "--port",
        "8100"
      ],
      "port": 8100,
      "autoPort": false
    },
    {
      "name": "video-ring",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "QUIET_MORNING_BY=23:59",
        "RING_MODE=live",
        "RING_POLL_SECONDS=0",
        "DB_PATH=submission/video/ring.db",
        "uv",
        "run",
        "uvicorn",
        "carekey.app:create_app",
        "--factory",
        "--port",
        "8101"
      ],
      "port": 8101,
      "autoPort": false
    }
  ]
}
# Copy to .env and fill in. Never commit .env.

# --- Ring -----------------------------------------------------------------
# fake = offline simulated doorbell (default). live = real Ring API / Playground token.
RING_MODE=fake
RING_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
# HMAC signing key issued with your Ring app credentials (verifies webhooks).
RING_HMAC_KEY=
RING_FRONT_DOOR_DEVICE_ID=fake.front-door
# Poll Ring Event History every N seconds (0 = webhooks only).
RING_POLL_SECONDS=0

# --- AWS --------------------------------------------------------------------
# fake = canned descriptions. ollama = vision model via Ollama. bedrock = Amazon Bedrock.
VISION_MODE=fake
OLLAMA_URL=http://localhost:11434
# Any Ollama model with vision, e.g. moondream (local) or gemma4:31b-cloud (hosted by ollama.com).
OLLAMA_VISION_MODEL=moondream
# rules = offline answers. bedrock = Strands agent on Amazon Bedrock.
AGENT_MODE=rules
AWS_REGION=us-east-1
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Home -------------------------------------------------------------------
DB_PATH=carekey.db
# Empty = this computer's timezone.
TIMEZONE=
PARENT_NAME=Mum
FAMILY_NAME=Ravi
QUIET_MORNING_BY=11:00
LATE_AFTER_MINUTES=15
UNLOCK_SECONDS=120
DEMO_ENABLED=true
